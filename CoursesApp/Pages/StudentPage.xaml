<UserControl x:Class="CoursesApp.Pages.StudentPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock x:Name="lblUserName" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
            <Button Content="Мои курсы" Width="200" HorizontalAlignment="Left" Height="32" Click="BtnCourses_Click" Margin="0,0,0,10"/>
            <Button Content="Выйти из учётной записи" Width="200" HorizontalAlignment="Left" Height="32" Click="BtnLogout_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
