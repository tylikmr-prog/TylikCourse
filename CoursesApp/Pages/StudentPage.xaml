<Page x:Class="CoursesApp.Pages.StudentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CoursesApp"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Кабинет студента">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock x:Name="lblUserName" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
            <Button Content="Мои курсы" Width="200" HorizontalAlignment="Left"
                    Height="32" Click="BtnCourses_Click" Margin="0,0,0,10"/>
            <Button Content="Выйти из учётной записи" Width="200" HorizontalAlignment="Left"
                    Height="32" Click="BtnLogout_Click"/>
        </StackPanel>
        
    </Grid>
</Page>
