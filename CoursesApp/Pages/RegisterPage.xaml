<UserControl x:Class="CoursesApp.Pages.RegisterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
            <TextBlock Text="Регистрация" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            <TextBlock Text="ФИО"/>
            <TextBox x:Name="tbFullName" Margin="0,4,0,10"/>
            <TextBlock Text="Логин"/>
            <TextBox x:Name="tbLogin" Margin="0,4,0,10"/>
            <TextBlock Text="Пароль"/>
            <PasswordBox x:Name="pbPassword" Margin="0,4,0,10"/>
            <TextBlock Text="Роль"/>
            <ComboBox x:Name="cbRole" Margin="0,4,0,15">
                <ComboBoxItem Content="Студент" IsSelected="True"/>
                <ComboBoxItem Content="Преподаватель"/>
            </ComboBox>
            <Button Content="Зарегистрироваться" Height="32" Click="BtnRegister_Click" Margin="0,0,0,8"/>
            <Button Content="Назад" Height="32" Click="BtnBack_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
