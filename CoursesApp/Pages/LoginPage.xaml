<Page x:Class="CoursesApp.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CoursesApp"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Авторизация">

    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
            <TextBlock Text="Вход в систему" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Логин"/>
            <TextBox x:Name="tbLogin" Margin="0,4,0,10"/>

            <TextBlock Text="Пароль"/>
            <PasswordBox x:Name="pbPassword" Margin="0,4,0,15"/>

            <Button x:Name="btnLogin" Content="Войти" Height="32"
                    Click="BtnLogin_Click" Margin="0,0,0,8"/>
            <Button x:Name="btnRegister" Content="Регистрация" Height="32"
                    Click="BtnRegister_Click"/>
        </StackPanel>
        
    </Grid>
</Page>
