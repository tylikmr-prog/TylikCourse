<UserControl x:Class="CoursesApp.Pages.LoginPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
            <TextBlock Text="Вход в систему" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            <TextBlock Text="Логин"/>
            <TextBox x:Name="tbLogin" Margin="0,4,0,10"/>
            <TextBlock Text="Пароль"/>
            <PasswordBox x:Name="pbPassword" Margin="0,4,0,15"/>
            <Button Content="Войти" Height="32" Click="BtnLogin_Click" Margin="0,0,0,8"/>
            <Button Content="Регистрация" Height="32" Click="BtnRegister_Click"/>
        </StackPanel>
    </Grid>
</UserControl>