<UserControl x:Class="CoursesApp.Pages.CoursePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="lblUserName" Grid.Row="0" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="1" Text="Список курсов:" Margin="0,0,0,10"/>
        <ListBox x:Name="lbCourses" Grid.Row="2" DisplayMemberPath="Title"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Назад в кабинет" Width="160" Height="32" Click="BtnBack_Click" Margin="0,0,8,0"/>
            <Button Content="Выйти" Width="100" Height="32" Click="BtnLogout_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
